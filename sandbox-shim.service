[Unit]
Description=Sandbox shim — narrow syschange HTTP front for n8n
Documentation=https://github.com/shoaibmahmud244-lang/n8n-syschange-shim
After=network.target
PartOf=default.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/sandbox-shim/shim.py
Environment=SHIM_BIND=172.31.90.1
Environment=SHIM_PORT=9922
Environment=PATH=%h/.local/share/mise/installs/opencode/latest:%h/.local/share/mise/shims:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin
Restart=on-failure
RestartSec=5

# Security boundary: runs as the unprivileged systemd user (%u), never root.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
SystemCallArchitectures=native

# Explicit write allowlist under ProtectHome=read-only:
ReadWritePaths=%h/.local/state/sandbox-shim
ReadWritePaths=%h/ai-system/syschange
ReadWritePaths=%h/.local/share/opencode
ReadWritePaths=%h/.cache/opencode
ReadWritePaths=%h/.config/opencode
ReadWritePaths=%h/.local/state/opencode

# Directives intentionally omitted after bisecting under systemd:
# - RestrictNamespaces=true and CapabilityBoundingSet= prevent bubblewrap (bwrap)
#   from creating user/mount namespaces (fails steps with rc=126 SandboxUnavailable).
# - MemoryDenyWriteExecute=true prevents V8 (spawned by opencode) from mapping
#   PROT_EXEC JIT pages, causing SIGTRAP on startup.

[Install]
WantedBy=default.target
